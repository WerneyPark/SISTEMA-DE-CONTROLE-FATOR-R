# ==============================================================================
# SISTEMA DE CONTROLE FATOR R - Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=fatorr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Backend API (Spring Boot)
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fatorr
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# ------------------------------------------------------------------------------
# Frontend (Angular)
# ------------------------------------------------------------------------------
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# Segurança & JWT (Preparado para Produção)
# ------------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_key_min_32_characters_long_fator_r_2026
JWT_EXPIRATION_MS=86400000
