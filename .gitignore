# ==============================================================================
# SISTEMA DE CONTROLE FATOR R - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env

# ------------------------------------------------------------------------------
# Java & Maven (Backend)
# ------------------------------------------------------------------------------
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
backend/HELP.md

# ------------------------------------------------------------------------------
# Node.js & Angular (Frontend)
# ------------------------------------------------------------------------------
frontend/node_modules/
**/node_modules/
frontend/dist/
**/dist/
frontend/.angular/
**/.angular/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA / WebStorm / CLion
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse & Spring Tool Suite (STS)
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ------------------------------------------------------------------------------
# Operating System Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Logs, Temporary Files & Databases
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
logs/
*.pid
*.seed
*.pid.lock
postgres_data/
